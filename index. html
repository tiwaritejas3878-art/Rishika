<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Special Surprise</title>
    <style>
        :root {
            --bg-color: #0d0205;
            --card-bg: rgba(25, 10, 15, 0.85);
            --neon-pink: #ff2a5f;
            --neon-glow: 0 0 15px rgba(255, 42, 95, 0.6);
            --text-color: #ffccd7;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: radial-gradient(circle, #20050f 0%, var(--bg-color) 100%);
            color: var(--text-color);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .screen {
            display: none;
            width: 100%;
            max-width: 400px;
            height: 100%;
            max-height: 750px;
            background: var(--card-bg);
            border: 1px solid rgba(255, 42, 95, 0.2);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8), inset 0 0 20px rgba(255, 42, 95, 0.05);
            padding: 30px 20px;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            position: relative;
            backdrop-filter: blur(10px);
        }

        .screen.active {
            display: flex;
            animation: fadeIn 0.5s ease forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }

        /* Utility Elements */
        .header-title {
            font-size: 1.6rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-shadow: var(--neon-glow);
            color: #fff;
            margin-top: 20px;
            text-align: center;
        }

        .hint-text {
            font-size: 0.85rem;
            color: #887076;
            margin-top: 5px;
            cursor: pointer;
            transition: color 0.3s;
        }
        .hint-text:hover { color: var(--neon-pink); }

        .btn {
            background: transparent;
            border: 1px solid var(--neon-pink);
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 0.95rem;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--neon-glow);
            text-transform: uppercase;
        }

        .btn:hover {
            background: var(--neon-pink);
            box-shadow: 0 0 25px var(--neon-pink);
        }

        /* SCREEN 1: Lockscreen Keypad */
        .avatar-container {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 2px solid var(--neon-pink);
            box-shadow: var(--neon-glow);
            overflow: hidden;
            cursor: pointer;
        }
        .avatar-container img { width: 100%; height: 100%; object-fit: cover; }

        .dots-container {
            display: flex;
            gap: 15px;
            margin: 30px 0;
        }
        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.2s;
        }
        .dot.active {
            background: var(--neon-pink);
            box-shadow: var(--neon-glow);
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            width: 100%;
            padding: 0 20px;
            margin-bottom: 20px;
        }
        .key {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.3rem;
            color: #fff;
            cursor: pointer;
            transition: background 0.2s;
        }
        .key:active { background: rgba(255, 42, 95, 0.3); }

        /* Hint Modal Popup */
        .modal {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 85%;
            background: #1a0810;
            border: 1.5px solid var(--neon-pink);
            border-radius: 16px;
            padding: 15px;
            box-shadow: 0 0 30px rgba(0,0,0,0.9);
            z-index: 10;
            flex-direction: column;
            align-items: center;
        }
        .modal img { width: 100%; border-radius: 10px; object-fit: cover; }
        .modal-close {
            position: absolute;
            top: 10px;
            right: 15px;
            cursor: pointer;
            font-size: 1.2rem;
        }
        .passkey-hint {
            margin-top: 12px;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }

        /* SCREEN 2: Loader */
        .loader-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
        }
        .panda-gif { width: 100px; height: 100px; margin-bottom: 20px; }
        .loading-text { font-size: 1.1rem; letter-spacing: 1px; }

        /* SCREEN 3: Intro */
        .sub-text { color: #a48a91; font-size: 0.95rem; text-align: center; }

        /* SCREEN 4: Age Ticker */
        .counter-box {
            display: flex;
            gap: 20px;
            margin: 40px 0;
        }
        .counter-item {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .counter-num {
            font-size: 2.8rem;
            font-weight: bold;
            color: #fff;
            text-shadow: var(--neon-glow);
        }
        .counter-label { font-size: 0.75rem; text-transform: uppercase; color: #887076; margin-top: 5px;}

        /* SCREEN 5: Carousel */
        .carousel-container {
            width: 100%;
            height: 350px;
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .carousel-track {
            display: flex;
            transition: transform 0.4s ease-in-out;
            width: 100%;
        }
        .slide {
            min-width: 100%;
            height: 320px;
            padding: 0 20px;
            display: flex;
            justify-content: center;
        }
        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

        /* SCREEN 6: Letter Card */
        .envelope {
            width: 140px;
            height: 100px;
            background: rgba(255,255,255,0.05);
            border: 1px dashed var(--neon-pink);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: var(--neon-glow);
            transition: transform 0.3s;
        }
        .envelope:hover { transform: scale(1.05); }
        .heart-icon { font-size: 2rem; color: var(--neon-pink); animation: pulse 1.2s infinite; }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        /* Final Letter Display Popup */
        .letter-content {
            width: 100%;
            background: rgba(20, 5, 10, 0.95);
            border: 1px solid var(--neon-pink);
            border-radius: 16px;
            padding: 25px 20px;
            text-align: left;
            line-height: 1.6;
            font-size: 0.95rem;
            height: 70%;
            overflow-y: auto;
        }
        .letter-footer-btns {
            display: flex;
            gap: 15px;
            width: 100%;
            margin-top: 15px;
        }
        .letter-footer-btns .btn { flex: 1; padding: 10px 0; text-align: center; font-size: 0.85rem;}

        /* Confetti Overlay */
        .confetti-canvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 99;
        }
    </style>
</head>
<body>

    <canvas class="confetti-canvas" id="confetti"></canvas>

    <!-- SCREEN 1: LOCK SCREEN -->
    <div class="screen active" id="screen-lock">
        <div style="display:flex; flex-direction:column; align-items:center;">
            <div class="avatar-container" onclick="toggleModal(true)">
                <!-- Replace with actual avatar image path -->
                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500" alt="Profile">
            </div>
            <h2 class="header-title" style="font-size:1.3rem;">LOCKED</h2>
            <p class="hint-text" onclick="toggleModal(true)">Hint - Click on picture to know passkey !</p>
        </div>

        <div class="dots-container" id="dots-box">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>

        <div class="keypad">
            <div class="key" onclick="pressKey('1')">1</div>
            <div class="key" onclick="pressKey('2')">2</div>
            <div class="key" onclick="pressKey('3')">3</div>
            <div class="key" onclick="pressKey('4')">4</div>
            <div class="key" onclick="pressKey('5')">5</div>
            <div class="key" onclick="pressKey('6')">6</div>
            <div class="key" onclick="pressKey('7')">7</div>
            <div class="key" onclick="pressKey('8')">8</div>
            <div class="key" onclick="pressKey('9')">9</div>
            <div class="key" onclick="clearKey()">⌫</div>
            <div class="key" onclick="pressKey('0')">0</div>
            <div class="key"></div>
        </div>

        <!-- Hint Modal -->
        <div class="modal" id="hint-modal">
            <span class="modal-close" onclick="toggleModal(false)">&times;</span>
            <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500" alt="Hint Picture">
            <div class="passkey-hint">PASSKEY = <strong>2026</strong></div>
        </div>
    </div>

    <!-- SCREEN 2: LOADER -->
    <div class="screen" id="screen-loader">
        <div class="loader-container">
            <!-- Simulated panda animation using simple placeholder/GIF link -->
            <div class="panda-gif"><h1 style="text-align:center;">🐼</h1></div>
            <p class="loading-text">Loading something special...</p>
            <p class="sub-text" style="margin-top:10px; font-size:0.8rem;">• JUST FOR YOU GUNNU•</p>
        </div>
    </div>

    <!-- SCREEN 3: SPECIAL DAY INTRO -->
    <div class="screen" id="screen-intro">
        <h2 class="header-title">It's Your Special Day 🌸</h2>
        <div style="font-size:4rem; margin: 40px 0;">🐼💤</div>
        <p class="sub-text">I made something special for you...</p>
        <button class="btn" onclick="nextScreen('screen-intro', 'screen-age')">Start •ิ_•ิ</button>
    </div>

    <!-- SCREEN 4: AGE COUNTER -->
    <div class="screen" id="screen-age">
        <h2 class="header-title" style="font-size:1.4rem;">Happy Birthday Rishika 🎀</h2>
        <p class="sub-text" style="font-size:0.85rem; margin-top:10px;">You have completed</p>
        
        <div class="counter-box">
            <div class="counter-item"><span class="counter-num" id="years-val">18</span><span class="counter-label">Years</span></div>
            <div class="counter-item"><span class="counter-num">0</span><span class="counter-label">Months</span></div>
            <div class="counter-item"><span class="counter-num" id="days-val">18</span><span class="counter-label">Days</span></div>
        </div>

        <button class="btn" onclick="nextScreen('screen-age', 'screen-memories')">Next ➔</button>
    </div>

    <!-- SCREEN 5: MEMORIES SLIDER -->
    <div class="screen" id="screen-memories">
        <div>
            <h2 class="header-title" style="font-size:1.3rem;">Special Memories</h2>
            <p class="sub-text" style="font-size:0.75rem; margin-top:5px;">Swipe for more ✨</p>
        </div>

        <div class="carousel-container">
            <div class="carousel-track" id="carousel-track" onclick="handleCarouselClick()">
                <!-- Replace with target memory pictures -->
                <div class="slide"><img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500" alt="Memory 1"></div>
                <div class="slide"><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=500" alt="Memory 2"></div>
                <div class="slide"><img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500" alt="Memory 3"></div>
            </div>
        </div>

        <button class="btn" onclick="nextScreen('screen-memories', 'screen-envelope')">💌 Message</button>
    </div>

    <!-- SCREEN 6: ENVELOPE -->
    <div class="screen" id="screen-envelope">
        <h2 class="header-title" style="font-size:1.3rem;">A Letter, Just For You</h2>
        <p class="sub-text" style="font-size:0.8rem;">Tap the heart to unseal your message...</p>
        
        <div class="envelope" onclick="openLetter()">
            <span class="heart-icon">❤️</span>
        </div>
        <div></div>
    </div>

    <!-- SCREEN 7: FINAL LETTER DISPLAY -->
    <div class="screen" id="screen-letter">
        <div style="text-align: center; width:100%;">
            <h3 style="color:#fff; font-size:1.1rem; letter-spacing:1px;">JUST FOR YOU ✨</h3>
            <p style="font-size:0.7rem; color:#887076;">From my heart to yours</p>
        </div>

        <div class="letter-content">
            <h4 style="color:var(--neon-pink); margin-bottom:10px;">Happy Birthday, Gunnu ❤️</h4>
            <p>You are the most beautiful part of my life, and I'm so lucky to have you Gunnu💖 You are the bestest Aur waise bhi aaj koi aisa waisa din thodi hai aaj to meri best friend ka birthday hai to aaj kuch to special hona chahiye tha na Once again Happy Birthday Bestie💞
            </p>
            <br>
            <p>Always stay happy — because your happiness means a lot to me. 💕</p>
        </div>

        <div class="letter-footer-btns">
            <button class="btn" onclick="triggerConfetti()">Celebrate 🎉</button>
            <button class="btn" style="border-color:#555; color:#aaa; box-shadow:none;" onclick="restartFlow()">Restart ↺</button>
        </div>
    </div>

    <script>
        // CONFIG & VARIABLES
        const CORRECT_PIN = "2026";
        let currentPin = "";
        let currentSlide = 0;

        // KEYPAD FUNCTIONS
        function pressKey(num) {
            if(currentPin.length < 4) {
                currentPin += num;
                updateDots();
            }
            if(currentPin.length === 4) {
                setTimeout(validatePin, 300);
            }
        }

        function clearKey() {
            currentPin = currentPin.slice(0, -1);
            updateDots();
        }

        function updateDots() {
            const dots = document.querySelectorAll('#dots-box .dot');
            dots.forEach((dot, index) => {
                if(index < currentPin.length) dot.classList.add('active');
                else dot.classList.remove('active');
            });
        }

        function validatePin() {
            if(currentPin === CORRECT_PIN) {
                nextScreen('screen-lock', 'screen-loader');
                setTimeout(() => {
                    nextScreen('screen-loader', 'screen-intro');
                    animateAgeCounter();
                }, 2500);
            } else {
                // Tweak design for error feedback
                const lockScreen = document.getElementById('screen-lock');
                lockScreen.style.border = "1px solid red";
                setTimeout(() => { 
                    lockScreen.style.border = "1px solid rgba(255, 42, 95, 0.2)";
                    currentPin = "";
                    updateDots();
                }, 500);
            }
        }

        function toggleModal(show) {
            document.getElementById('hint-modal').style.display = show ? 'flex' : 'none';
        }

        // NAVIGATION
        function nextScreen(currentId, nextId) {
            document.getElementById(currentId).classList.remove('active');
            document.getElementById(nextId).classList.add('active');
        }

        // COUNTER TICKER ANIMATION (Screen 4)
        function animateAgeCounter() {
            let yearVal = 18;
            let dayVal = 18;
            
            // Simulating continuous rolling/ticking effect as in reference video
            const yearEl = document.getElementById('years-val');
            const dayEl = document.getElementById('days-val');

            let count = 0;
            const interval = setInterval(() => {
                yearEl.textContent = yearVal + (count % 2);
                dayEl.textContent = dayVal + count;
                count++;
                if(count > 10) {
                    clearInterval(interval);
                    yearEl.textContent = "19"; // Final milestone target values
                    dayEl.textContent = "19";
                }
            }, 100);
        }

        // CAROUSEL CLICK HANDLER (Simple toggle loop)
        function handleCarouselClick() {
            const track = document.getElementById('carousel-track');
            currentSlide = (currentSlide + 1) % 3;
            track.style.transform = `translateX(-${currentSlide * 100}%)`;
        }

        // LETTER POPUP OPEN
        function openLetter() {
            nextScreen('screen-envelope', 'screen-letter');
            triggerConfetti();
        }

        function restartFlow() {
            currentPin = "";
            currentSlide = 0;
            document.getElementById('carousel-track').style.transform = `translateX(0%)`;
            updateDots();
            
            // Go back to absolute first page
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('screen-lock').classList.add('active');
        }

        // CELEBRATION CONFETTI EFFECT
        const canvas = document.getElementById("confetti");
        const ctx = canvas.getContext("2d");
        let pieces = [];
        let animationFrame;

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function createConfettiPiece() {
            return {
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height - canvas.height,
                rotation: Math.random() * 360,
                color: ['#ff2a5f', '#ff7da0', '#fff', '#ffccd7'][Math.floor(Math.random() * 4)],
                width: Math.random() * 8 + 4,
                height: Math.random() * 10 + 5,
                speed: Math.random() * 3 + 2,
                rotationSpeed: Math.random() * 10 - 5
            };
        }

        function updateConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            pieces.forEach((p, idx) => {
                p.y += p.speed;
                p.rotation += p.rotationSpeed;
                ctx.save();
